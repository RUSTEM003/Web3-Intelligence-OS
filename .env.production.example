NODE_ENV=production
PORT=3000
SITE_URL=https://medtour.ai

DATABASE_URL=mysql://medtour_user:secure_password@mysql:3306/medtour
REDIS_URL=redis://redis:6379

MYSQL_ROOT_PASSWORD=super_secure_root_password
MYSQL_USER=medtour_user
MYSQL_PASSWORD=secure_password

AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET=medtour-storage

OPENAI_API_KEY=sk-your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key
OPENWEATHER_API_KEY=your_openweather_api_key
NEWS_API_KEY=your_news_api_key

CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

RTMP_STREAM_KEY=medtour_stream_key_2024
RTMP_AUTH_URL=http://medtour:3000/api/stream/auth
RTMP_PUBLISH_DONE_URL=http://medtour:3000/api/stream/end
HLS_FRAGMENT_DURATION=3
HLS_PLAYLIST_LENGTH=60
RECORDING_ENABLED=true

GPU_WORKER_CONCURRENCY=4
VIDEO_WORKER_CONCURRENCY=2
AI_WORKER_CONCURRENCY=3
